# ────────────────────────────────────────────────────────────────────────────
# ⚠ مفاتيح التوقيع — نشرُها يمكّن أيَّ أحد من إصدار «تحديث» مزوّر لإضافتك
# ────────────────────────────────────────────────────────────────────────────
*.pem
*.crx

# ────────────────────────────────────────────────────────────────────────────
# ⚠ مادة مملوكة لـAnthropic — لا تُنشر
# النصوص الإنجليزية مفاتيحُ ضرورية داخل القاموس (للمطابقة والتشغيل)، أما نشرها
# مفردةً في ملفات مستقلة فهو إعادة نشر لمحتوى الغير لا مسوّغ له.
# ────────────────────────────────────────────────────────────────────────────
web/code/glossary/claude-ALL-strings.txt
web/code/glossary/_*.txt
web/code/glossary/_*.json
desktop/code/locale/en-US.json
desktop/code/locale/claude-ai/en-US.json
desktop/code/locale/claude-ai/_batches_in/
desktop/code/locale/claude-ai/_todo-*.jsonl
desktop/code/locale/claude-ai/_still-missing.jsonl

# ────────────────────────────────────────────────────────────────────────────
# ملفات عمل مؤقتة ومجلدات خاصة
# ────────────────────────────────────────────────────────────────────────────
web/code/glossary/_translate-inbox/
web/_backup-*/
desktop/user/_خاص-لا-يُشارك.zip
desktop/user/*.zip

# ────────────────────────────────────────────────────────────────────────────
# نظام التشغيل والمحرّرات
# ────────────────────────────────────────────────────────────────────────────
node_modules/
.DS_Store
Thumbs.db
desktop.ini
*.log
.vscode/
.idea/
