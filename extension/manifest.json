{
  "manifest_version": 3,
  "name": "تعريب كلود للويب — واجهة Claude.ai بالعربية (غير رسمي)",
  "short_name": "تعريب كلود للويب",
  "version": "1.0.0",
  "version_name": "1.0.0 — قاموس 22414 عبارة",
  "description": "يعرّب واجهة claude.ai مع الاتجاه من اليمين لليسار. مستقل غير رسمي. لا يخزّن شيئًا مما يظهر على شاشتك ولا يرسله لأي جهة.",
  "author": "عبدالسلام الشلاش",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://*.claude.ai/*"
      ],
      "js": [
        "cml-const.js",
        "cml-shared.js",
        "dictionary.js",
        "engine.js"
      ],
      "css": [
        "base.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "تعريب كلود للويب",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "minimum_chrome_version": "102"
}
